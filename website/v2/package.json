{
  "name": "cairn-website-concept",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "esbuild ui/interactions.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\"\\\"production\\\"\" --outfile=assets/cairn-interactions.js",
    "build:docs": "node ui/build-docs-preview.cjs",
    "test:docs": "node ui/check-docs.cjs",
    "test": "node ui/check-interactions.cjs",
    "test:story": "node ui/check-storage-story.cjs",
    "test:motion": "node ui/check-storage-story.cjs",
    "test:scene": "node ui/check-storage-story.cjs",
    "build:story": "esbuild ui/storage/index.mjs --bundle --minify --format=iife --target=es2020 --outfile=assets/cairn-storage-story.js",
    "test:storage": "node ui/check-storage-story.cjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
